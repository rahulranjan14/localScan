# ── Handoff material — reference only, not part of the build ──────────────
handoff/
*.zip

# ── Node ─────────────────────────────────────────────────────────────────
node_modules/
dist/
build/
*.tsbuildinfo
.vite/

# ── Secrets & local config ───────────────────────────────────────────────
.env
.env.local
.env.*.local
data/config.json

# ── Runtime data (PDFs live on disk, keyed by sha256) ────────────────────
data/files/
*.log

# ── OS / editor ──────────────────────────────────────────────────────────
.DS_Store
.idea/
*.swp

# ── Build output ─────────────────────────────────────────────────────────
dist/
*.tsbuildinfo

# ── Local runtime data ───────────────────────────────────────────────────
data/

# ── Eval fixtures are COMMITTED, never ignored ───────────────────────────
# The predecessor system gitignored *.pdf and its metrics, leaving 20 approved
# labels pointing at fixtures nobody had. Negated here so a later *.pdf rule
# cannot quietly undo reproducibility.
!packages/eval/fixtures/**
!packages/eval/labels.json

