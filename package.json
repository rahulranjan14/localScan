{
  "name": "agentic-ocr",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first document intelligence. PDF in, validated typed JSON out.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @ocr/server",
    "dev:web": "npm run dev -w @ocr/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "npm run migrate -w @ocr/server",
    "check:inference": "tsx scripts/check-inference.mts",
    "extract": "tsx scripts/extract.mts",
    "spike:rasterise": "tsx --expose-gc scripts/spike-rasterise.mts"
  },
  "devDependencies": {
    "@hyzyla/pdfium": "^2.1.13",
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^22.10.2",
    "concurrently": "^9.2.4",
    "pdf-to-img": "^6.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.5"
  }
}
