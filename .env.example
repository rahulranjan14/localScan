# Copy to .env and adjust. Every value here is a real default, not a placeholder.

# ── Database ─────────────────────────────────────────────────────────────
# Loopback only (FR-11.5). Postgres 14 or later; pgvector is not needed until
# the retrieval phase.
DATABASE_URL=postgres://localhost:5432/ocr

# ── Inference host ───────────────────────────────────────────────────────
# Where Ollama is listening. On this project inference runs on a separate LAN
# machine, so this is normal configuration rather than an advanced option.
# Ollama binds to localhost by default; to accept LAN connections it must be
# started with OLLAMA_HOST=0.0.0.0 on *that* machine.
#
# On macOS, point this at loopback and run the forwarder instead:
#
#     npm run proxy -- 192.168.1.50
#
# macOS gates Local Network access per application, so a tool running inside an
# editor can reach the internet and the router but not another machine on the
# same LAN -- and the failure reports as a connection refusal, not a permission
# error. Loopback is exempt, so forwarding sidesteps the whole class of problem.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Role bindings ────────────────────────────────────────────────────────
# One model per pipeline stage. Unset roles report as 'unconfigured' rather
# than silently falling back to another model.
# One model per pipeline role. These are the small defaults: they fit in a few
# GB each and are what the quickstart pulls. Swapping any of them is this file
# and a restart -- see docs/BENCHMARKS.md for what the larger ones buy.
OCR_MODEL_CLASSIFY=qwen2.5:3b
OCR_MODEL_EXTRACT=qwen2.5:3b
OCR_MODEL_EMBED=nomic-embed-text

# Only used for pages with no text layer, so a scan-free corpus never loads it.
OCR_MODEL_OCR=granite3.2-vision

# Optional. Retried extraction goes to this model instead, so it is worth making
# it a different family from OCR_MODEL_EXTRACT rather than the same one twice.
# OCR_MODEL_FALLBACK=llama3.2:3b
# OCR_MODEL_OCR=granite3.2-vision      # needed from the vision phase
# OCR_MODEL_EMBED=nomic-embed-text     # needed from the retrieval phase
# OCR_MODEL_FALLBACK=llama3.2:3b       # must differ from extract to be useful

# ── Where text comes from ────────────────────────────────────────────────
# auto        text layer when usable, vision model otherwise (default)
# always_vlm  rasterise and transcribe every document — slower, and sometimes
#             more accurate, because a PDF's text layer can be mangled where a
#             rendered page is not
# prefer_text text layer whenever there is any at all; never calls a vision model
OCR_TEXT_MODE=auto

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000

# ── Paths ────────────────────────────────────────────────────────────────
# OCR_DATA_DIR=data
# OCR_DOCUMENTS_DIR=documents

# Development only: allow re-running a document already stored, so an OCR prompt
# or model can be compared on the same file. Off by default -- a re-upload should
# cost nothing in normal use (FR-1.3).
# OCR_ALLOW_REPROCESS=true

# The inference host on your LAN, used by scripts/lan-proxy.mjs when no address
# is passed on the command line. The forwarder exists because macOS gates Local
# Network access per application -- see that file for why.
#
# OCR_INFERENCE_HOST=192.168.1.50

# Inside containers the models are not on loopback. docker-compose.yml points at
# host.docker.internal by default; set this to override, e.g. another machine.
# DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
